---
/* This code is for the main page */
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Hero from "@/components/Hero.astro";
import WhatIDo from "@/components/WhatIDo.astro";
import Itinerary from "@/components/Itinerary.astro";
import SponsorBanner from "@/components/SponsorBanner.astro";
import HeaderSpacer from "@/components/HeaderSpacer.astro";
import PrizeBanner from "@/components/PrizeBanner.astro";
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="p-0 m-0 max-w-screen">
    <Header />
    <HeaderSpacer />
    </div>
    <main class="container mx-auto md:px-10">
      <Hero />
      <SponsorBanner />
      <PrizeBanner />
      <a name="faq-panel">
        <h1 style="padding-top: 185px; margin-top: -185px;"></h1>
      </a>
      <WhatIDo />
    </main>
    <Footer />
  </body>
</html>
