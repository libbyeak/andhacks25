---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
import SponsorTableImage from "@/assets/img_3476.jpg"; /* apparently this doesn't work if the file name is uppercase? seriously? */
import { getCollection } from "astro:content";
import SponsorBadge from "@/components/SponsorBadge.astro";
import HeaderSpacer from "@/components/HeaderSpacer.astro";
const sponsors = await getCollection('sponsors');
import FergusonLogo from "src/content/sponsors/ferguson.png";
import TaylorLogo from "src/content/sponsors/taylor.png";
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <HeaderSpacer />
        <div class="flex flex-col group object-contain ">
            <div class="flex flex-col bg-pevergreen items-center content-center rounded-xl border-black border-2 p-7 m-7">
                <p class="text-4xl md:text-7xl text-white">Sponsor &hacks XI</p>
            </div>
        </div>
        <!-- Presumably there are right things to say here, but I don't know what those things are
            This is the best I could think of  
        -->
        <div class="flex flex-row object-contain">
            <div class="flex flex-col justify-center  justify-self-center items-center content-center w-1/2 p-10 m-10">
                <p class="text-center text-2xl lg:w-7/8">We're currently looking for sponsors for &hacks '25, which will be in September 2025. 
                    Sponsors get to recruit in-person at the hackathon, among other benefits. If you're interested in 
                    sponsoring our hackathon, please reach out to <a class="text-blue-900 underline" href="mailto:computing@wm.edu">computing@wm.edu</a>,
                    and a member of our team will be in touch.
                </p>
            </div>
            <div class="flex flex-col justify-end w-1/2 p-10 m-10">
                <div class="p-8 border-6 border-black rounded-xl">
                    <Image class="shadow rounded-xl" src={SponsorTableImage} alt="Sponsors tabling at &hacks X" />
                </div>
            </div>
        </div>
        <div class="flex flex-row min-w-full object-contain group justify-center items-center content-center">
            <div class="flex flex-col border-8 border-black rounded-xl p-5 m-5 justify-center items-center grow-1">
                <p class="text-7xl">60%</p>
                <p class="text-xl">First-time hackers</p>
           </div>
           <div class="flex flex-col border-8 border-black rounded-xl p-5 m-5 justify-center items-center grow-1">
                <p class="text-7xl">33%</p>
                <p class="text-xl">Non-CS Majors</p>
            </div>
         <div class="flex flex-col border-8 border-black rounded-xl p-5 m-5 justify-center items-center grow-1">
                <p class="text-7xl">200+</p>
                <p class="text-xl">Registrants</p>
            </div>
            <div class="flex flex-col border-8 border-black rounded-xl p-5 m-5 justify-center items-center grow-1">
                <p class="text-7xl">30+</p>
                <p class="text-xl">Projects</p>
            </div>
            </div>
            <div class="flex justify-self-center justify-center items-center content-center p-10 m-10">
        <div class="flex flex-col">
            <p class="text-4xl md:text-7xl text-center mb-4 underline">Our Sponsors</p>
            <div class="flex flex-col justify-self-center justify-center items-center content-center object-contain group gap-0 p-0px">
                <p class="text-2xl">Platinum Sponsor</p>
                <div class="flex justify-self-center ">
                    <SponsorBadge
                    name="Ferguson"
                    tier={3}
                    logo={FergusonLogo}
                    website="https://ferguson.com"
                    color="bg-amber-300"
                    />
                </div>
                <p class="text-2xl">Silver Sponsor</p>
                <div class="flex justify-self-center">
                    <SponsorBadge
                    name="Taylor Engineering"
                    tier={2}
                    logo={TaylorLogo}
                    website="https://taylorengineering.com"
                    color="bg-amber-300"
                    />
                </div>
            </div>
        <div class="flex flex-col items-center content-center">
        <p class="text-2xl mt-5 text-center">Bronze Sponsors</p>
        <ul class="grid grid-cols-4 md:grid-cols-4 xl:grid-cols-4 md:w-3/4 auto-rows-fr">
          {
          sponsors.sort((a,b)=> { return b.data.tier - a.data.tier }).map((s) => (
            s.data.tier == 1 ?
              (
                <li class="grid col-span-1">
                  <SponsorBadge
                    name={s.data.name}
                    tier={s.data.tier}
                    logo={s.data.logo}
                    website={s.data.website}
                    color="bg-amber-300"
                  />
                </li>
                )
                :
                ""
              ))
            }
         </ul>
      </div>
      <div class="flex flex-col justify-center items-center content-center">
        <p class="text-2xl mt-5">Partners</p>
        <ul class="grid grid-cols-3 md:grid-cols-4 xl:grid-cols-6 auto-rows-fr">
          {
          sponsors.sort((a,b)=> { return b.data.tier - a.data.tier }).map((s) => (
            s.data.tier == 0 ?
              (
                <li class="grid col-span-1">
                  <SponsorBadge
                    name={s.data.name}
                    tier={s.data.tier}
                    logo={s.data.logo}
                    website={s.data.website}
                    color="bg-amber-300"
                  />
                </li>
                )
                :
                ""
              ))
            }
         </ul>
      </div>
      </div>  
    </div>
    </div>
    <Footer />
    </body>
</html>