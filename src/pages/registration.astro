---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
import HeaderSpacer from "@/components/HeaderSpacer.astro";
import Image from "astro/components/Image.astro";
import CheckInImage from "@/assets/checkin.jpg";
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <!--AFTER THE MAIN DIV; CREATE NEW DIV CLASS = "FLEX" TO ADD PICTURE<meta http-equiv="refresh" content="0; url=https://forms.gle/64ZWmwTfgEDdzFGRA" -- Done 9/6/25 /> -->
    </head>
    <body>
        <Header />
        <HeaderSpacer />
        <main class="container mx-auto md:px-10">
            <p class="text-4xl mb-10 underline text-bold text-center">Register for &hacks XI</p>
            <div class="flex flex-col md:flex-row">
                <div class="flex md:w-1/2 object-contain">
                    <div class="grid auto-rows gap-4 grid-columns-1 object-fit">
                        <div class="grid items-center content-center text-center sm:w-11/12 px-8 rounded-3xl border-1 border-black shadow-card py-25 gap-6">
                            <p class="text-3xl underline">Hacker</p>
                            <p class="text-xl">Come to &hacks! Work on a project (whether you have a team or not) to win prizes, or just come for the workshops and good vibes! No pressure; do what you feel!</p>
                            <a class="bg-amber-300 rounded-xl shadow-card hover:shadow-hover transition p-3 m-3" href="https://forms.gle/64ZWmwTfgEDdzFGRA">Register to Hack</a>
                        </div>
                        <div class="grid items-center content-center text-center sm:w-11/12 px-8 rounded-3xl border-1 border-black shadow-card py-25 gap-6">
                            <p class="text-3xl underline">Volunteer</p>
                            <p class="text-xl">Help the &hacks team work to put on the best hackathon possible!</p>
                            <a class="bg-amber-300 rounded-xl shadow-card hover:shadow-hover transition p-3 m-3" href="https://docs.google.com/forms/d/e/1FAIpQLSf0s6RFXEy6woRyFqS7TdN3spT8roGUriLKxvxLWGTLoDJSjQ/viewform?usp=header">Register to Volunteer</a>
                        </div>
                        <div class="grid items-center content-center text-center sm:w-11/12 px-8 rounded-3xl border-1 border-black shadow-card py-30 gap-6 mb-10">
                            <p class="text-3xl underline">Judges & Mentors</p>
                            <p class="text-xl">Decide the winners or help the hackers!</p>
                            <a class="bg-amber-300 rounded-xl shadow-card hover:shadow-hover transition p-3 m-3" href="https://docs.google.com/forms/d/e/1FAIpQLSd3IWV6RJ3rDQXGqAikpvq91X6FVTPN_gL3A25sZ9uPPLqDgg/viewform">Register to Judge</a>
                        </div>
                    </div>
                </div>
                <div class="flex flex-row mb-5 md:mb-0md:w-1/2 justify-center items-center content-center ">
                    <Image class="object-fit rounded-xl border-2 border-black" src={CheckInImage} alt="Hackers at &hacks X" />
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>