---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <div class="py-256px px-256px">
           <p class="text-7xl"> &nbsp &nbsp</p>
            <p class="text-7xl"> &nbsp &nbsp</p>
            <p class="text-4xl">&nbsp</p> 
        </div>
        <div class="flex flex-row justify-center items-center content-center">
            <a class="bg-pgreen rounded-xl shadow-card hover:shadow-hover transition border-2 border-black p-5 m-5" href="/authentication">Click here to register for &hacks</a>
        </div>
        <Footer />
    </body>
</html>