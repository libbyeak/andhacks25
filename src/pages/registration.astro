---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <div class="py-256px px-256px">
           <p class="text-7xl"> &nbsp &nbsp</p>
            <p class="text-7xl"> &nbsp &nbsp</p>
            <p class="text-4xl">&nbsp</p> 
        </div>
        <form class="stacked-form justify-center justify-items-center" action="signup" method="post">
            <iframe src="https://forms.gle/aC38oXgBCv2bC46z6"
                width="640" height="800" frameborder="0" marginheight="0" marginwidth="0">
            </iframe>
        </form>
        <Footer />
    </body>
</html>