---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
import HeaderSpacer from "@/components/HeaderSpacer.astro";
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <!--<meta http-equiv="refresh" content="0; url=https://forms.gle/64ZWmwTfgEDdzFGRA" /> -->
    </head>
    <body>
        <Header />
        <HeaderSpacer />
        <main class="container mx-auto md:px-10">
            <p class="text-4xl mb-10 underline text-bold">Register for &hacks XI</p>
            <div class="flex flex-col sm:flex-row justify-center justify-self-center items-center content-center">
                <div class="flex flex-col items-center content-center text-center sm:w-1/3 px-10">
                    <p class="text-3xl underline">Hacker</p>
                    <p class="text-xl">Come to &hacks, work on a project, and submit it for judging!</p>
                    <a class="bg-amber-300 rounded-xl shadow-card hover:shadow-hover transition p-3 m-3" href="https://forms.gle/64ZWmwTfgEDdzFGRA">Register to Hack</a>
                </div>
                <div class="flex flex-col items-center content-center text-center sm:w-1/3 px-10">
                    <p class="text-3xl underline">Volunteer</p>
                    <p class="text-xl">Help the &hacks team work to put on the best hackathon possible!</p>
                    <a class="bg-amber-300 rounded-xl shadow-card hover:shadow-hover transition p-3 m-3" href="https://docs.google.com/forms/d/e/1FAIpQLSf0s6RFXEy6woRyFqS7TdN3spT8roGUriLKxvxLWGTLoDJSjQ/viewform?usp=header">Register to Volunteer</a>
                </div>
                <div class="flex flex-col items-center content-center text-center sm:w-1/3 px-10">
                    <p class="text-3xl underline">Judge</p>
                    <p class="text-xl">Decide the winners!</p>
                    <a class="bg-amber-300 rounded-xl shadow-card hover:shadow-hover transition p-3 m-3" href="https://docs.google.com/forms/d/e/1FAIpQLSd3IWV6RJ3rDQXGqAikpvq91X6FVTPN_gL3A25sZ9uPPLqDgg/viewform">Register to Judge</a>
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>