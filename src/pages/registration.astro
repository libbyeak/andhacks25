---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
import HeaderSpacer from "@/components/HeaderSpacer.astro";
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <meta http-equiv="refresh" content="0; url=https://forms.gle/64ZWmwTfgEDdzFGRA" />
    </head>
    <body>
        <Header />
        <HeaderSpacer />
        <div class="flex flex-row justify-center items-center content-center">
            <a class="bg-pgreen rounded-xl shadow-card hover:shadow-hover transition border-2 border-black p-5 m-5" href="/authentication">If this page does not automatically redirect you, please click this link to register for &hacks XI</a>
        </div>
        <Footer />
    </body>
</html>