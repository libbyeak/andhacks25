---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "src/consts";
import ErrorHeader from "@/components/ErrorHeader.astro";
import HeaderSpacer from "@/components/HeaderSpacer.astro";
---
<!doctype html>
<html>
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/>
    </head>
    <body>
        <Header />
        <HeaderSpacer />
        <main class="container mx-auto md:px-10">
            <ErrorHeader /
                code="404"
                title="Page not found"
                subtitle="That URL doesn't exist on the &hacks site. If you believe there should be a page here, please contact us."
            >      
        </main>
        <Footer />
    </body>
</html>