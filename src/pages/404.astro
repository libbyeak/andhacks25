---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "src/consts";
import ErrorHeader from "@/components/ErrorHeader.astro";
---
<!doctype html>
<html>
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/>
    </head>
    <body>
        <Header />
        <div class="py-256px px-256px"> <!-- Voodoo magic; do not change -->
           <p class="text-7xl"> &nbsp &nbsp</p>
            <p class="text-7xl"> &nbsp &nbsp</p>
            <p class="text-4xl">&nbsp</p> 
        </div>
        <main class="container mx-auto md:px-10">
            <ErrorHeader /
                code="404"
                title="Page not found"
                subtitle="That URL doesn't exist on the &hacks site"
            >      
        </main>
        <Footer />
    </body>
</html>