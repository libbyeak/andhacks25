---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
import {getEvents} from "src/scripts/notion.ts"
import HeaderSpacer from "@/components/HeaderSpacer.astro";
const allEvents = await getEvents(false);
const now = new Date()
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <HeaderSpacer />
        <div class="flex justify-center justify-items-center text-left bg-slate-400">
            <table class="table-auto w-5/6">
                <thead>
                    <th class="py-8">Date/Time</th>
                    <th class="py-8">Event Name</th>
                    <th class="py-8">Location</th>
                    <!-- <th class="py-8">Website</th>-->
                </thead>
                <tbody>
                    {
                    allEvents ? 
                    (
                    allEvents.map(event => (
                            <tr class={(new Date().getDate() == event.date.getDate() && new Date().getHours() == event.date.getHours())  ? "bg-red-700" : "odd:bg-pgreen even:bg-pyellow"}>
                                <td class="py-3"><a name={event.date.toISOString()}><p class="hidden" style="margin-top: -70px;"></p></a>{event.date.toLocaleString('en-US', {year: "numeric", month: "long", day: "numeric", hour: 'numeric', hour12: true, minute: 'numeric', timeZone: 'America/New_York'})}</td>
                                <td class="py-3"><strong>{event.name}</strong></td>
                                <td class="py-3">{event.location}</td>
                                
                                <!-- <td><a href={event.website} target="_blank">{event.website}</a></td> -->
                            </tr>
                        ))
                    )
                    :
                    (
                        <tr class="bg-pgreen"><td colspan="4"><p class="text-xl text-center py-3">Could not display events at this time</p></td></tr>
                    )
                    }
                </tbody>
            </table>
        </div>
        <Footer />
    </body>
</html>