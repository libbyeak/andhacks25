---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
import {getEvents} from "src/scripts/notion.ts"
const allEvents = await getEvents();
const now = new Date()
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <div class="py-256px px-256px">
            <!-- it turns out that if you don't have text in a div, a div you're trying to use to add space, the height
        is always coerced to 0. That's irritating. Add invisible text to hint that this space is important -->
        <p class="text-7xl"> &nbsp &nbsp</p>
        <p class="text-7xl"> &nbsp &nbsp</p>
        <p class="text-4xl">&nbsp</p>
        </div>
        <div class="flex justify-center justify-items-center bg-slate-400">
            <table class="table-auto w-5/6">
                <thead>
                    <th class="py-8">Date/Time</th>
                    <th class="py-8">Event Name</th>
                    <th class="py-8">Location</th>
                    <th class="py-8">Website</th>
                </thead>
                <tbody>
                    {
                    allEvents ? 
                    (
                    allEvents.map(event => (
                        <div class="m-0 p-0" id={event.date ? event.date.getTime().toString() : ""}> <!-- auto-navigate to anchor for the current time -->
                            <tr class="odd:bg-pgreen even:bg-pyellow">
                                <td class="py-3">{event.date ? event.date.toDateString() : "TBA"}</td>
                                <td class="py-3"><strong>{event.name}</strong></td>
                                <td class="py-3">{event.location}</td>
                                <td><a href={event.website} target="_blank">{event.website}</a></td>
                            </tr>
                        </div>
                        ))
                    )
                    :
                    (
                        <tr class="bg-pgreen"><td colspan="4"><p class="text-xl text-center py-3">Could not display events at this time</p></td></tr>
                    )
                    }
                </tbody>
            </table>
        </div>
        <Footer />
    </body>
</html>