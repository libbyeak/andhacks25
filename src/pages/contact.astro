---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "src/consts";
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <div class="py-256px px-256px">
            <!-- it turns out that if you don't have text in a div, a div you're trying to use to add space, the height
        is always coerced to 0. That's irritating. Add invisible text to hint that this space is important -->
        <p class="text-7xl"> &nbsp &nbsp</p>
        <p class="text-7xl"> &nbsp &nbsp</p>
        <p class="text-4xl">&nbsp</p>
        </div>
        <main class="container mx-auto md:px-10">
            <p class="text-2xl lg:text-5xl text-center mt-20 mb-20">To contact us, please email <a href="mailto:computing@wm.edu">computing@wm.edu</a></p>
        </main>
        <Footer />
    </body>