---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "src/consts";
import ErrorHeader from "@/components/ErrorHeader.astro";
import HeaderSpacer from "@/components/HeaderSpacer.astro";
---
<!doctype html>
<html>
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/>
    </head>
    <body>
        <Header />
        <HeaderSpacer />
        <main class="container mx-auto md:px-10">
            <ErrorHeader /
                code="500"
                title="Internal server error"
                subtitle="Something went wrong on our end. Please refresh the page, or try again later"
            >      
        </main>
        <Footer />
    </body>
</html>