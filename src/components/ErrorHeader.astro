---
import { Image } from "astro:assets";
import AstronautImage from "src/assets/adriana.jpg";

export interface Props {
    code: string;
    title:string;
    subtitle: string;
}
const {code, title, subtitle} = Astro.props;

---
<section class="py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <p class="text-8xl font-bold">{code}</p>
    <p class="text-6xl font-bold"> {title}</p>
    <p>
      {subtitle}
    </p>
    <a
      href="/"
      class="bg-pgreen px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition"
    >
      Return to Home
    </a>
  </div>
  
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <Image src={AstronautImage} alt="Error image" />
  </div>
</section>
