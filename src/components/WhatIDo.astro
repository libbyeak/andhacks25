---
/* This is the widget that has all the tiles.*/
import { getCollection } from "astro:content";
const posts = (await getCollection("blog"));

let getRandomClassIndex = -1; /* this seems like the easiest shim for function-level static variables in TS */

const bgClasses = [
  "bg-pgreen w-64 h-15 rounded-xl",
  "bg-pblue w-64 h-15 rounded-xl",
  "bg-ppink w-64 h-15 rounded-xl",
  "bg-pyellow w-64 h-15 rounded-xl",
];

const getRandomClass = () => {
  /* static int index; -- but this isn't C */
  /* Some notes on this function:
   * It's called every time a tile is created, and returns the name of a CSS class that sets the background color for
   * that tile's icon. Originally, this was random, but I (RDR) thought the design should be consistent across visits.
   * I therefore changed it to be deterministic, using a global variable. Note that this is a pain, because TS doesn't
   * have an easy way to get function-level static variables.
   */
  getRandomClassIndex++;
  return bgClasses[getRandomClassIndex % bgClasses.length]; //[Math.floor(Math.random() * bgClasses.length)];
};
---

<section class="flex flex-col text-center gap-4 "> <!-- id="faq-panel">-->
  <p class="text-pblack">Got questions?</p>
  <h2 class="text-8xl font-bold">FAQs</h2>
  <ul class="flex flex-wrap justify-center gap-4 py-10">
    {
      posts.map((post) => {
        const randomClass = getRandomClass();
        return (
          <li class="w-80 h-25 text-left rounded-3xl border-1 border-black shadow-card group hover:shadow-hover transition  px-4 py-6 flex flex-col gap-6">
             <a class="flex flex-col gap-4">
              <div
                class={`inline-block text-xl font-semibold px-2 py-1 border border-black shadow-card1 group-hover:shadow-card transition ${randomClass}`}>
                {post.data.title}
              </div>
              <p class="date -mt-4 text-sm font-light">
              </p>
            </a>
            <div set:html={post.data.description} />
          </li>
        );
      })
    }
  </ul>
</section>