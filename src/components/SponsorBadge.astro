---
import Image from "astro/components/Image.astro";
import Picture from "astro/components/Picture.astro";
import { type ImageMetadata } from "astro";
import { imageConfig } from "astro:assets";

export interface Props {
    name: string;
    tier: string;
    src: ImageMetadata;
    width: number;
    height: number
}

const {name, tier, src, width, height} = Astro.props;
const images = import.meta.glob<{default: ImageMetadata}>('../assets/sponsors/*.{svg,png}')

console.log('IMAGES ARE: ' + JSON.stringify(images));
---
<div class="flex flex-col p-2 m-2 border-1 bg-pgreen border-black rounded-xl justify-center items-center">
<Picture src={src} alt="lorem ipsum dolor sit amet" class="brightness-0"/>
<!--<img
    width={width}
    height={height}
    src={src}
    alt={alt}
/> -->
</div>