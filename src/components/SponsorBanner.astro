---
import { Icon } from "astro-icon/components"; /* not used but maybe they will be */
import { Image } from "astro:assets";
//import { getEvents } from 'src/scripts/notion';
import { type CollectionEntry, getCollection } from "astro:content";
import SponsorBadge from "@/components/SponsorBadge.astro";
const sponsors = await getCollection('sponsors');
---
<section class=" bg-pevergreen border-2 border-black group rounded-xl sm:m-5 sm:p-5">
  <!-- grey so as to be least likely to conflict with sponsors' logos -->
  <!-- <div class="grid row-start-1">
    <div class="flex gap-0 justify-start items-start">
      <h3 class="text-6xl">Our Sponsors</h3>
    </div>
  </div>-->
  <div class="grid row-start-1">
    <!-- This is what I changed, from a flex layout directive, to make the "Sponsor Us" button be vertically centered. It was some voodoo bullshit, I tell you. -->
    <div class="flex flex-row justify-content justify-items-stretch px-4 md:px-0 lg:gap-10 md:gap-0">
      <div class="flex flex-col gap-0 justify-start items-start w-2/3 md:w-5/6 p-0px">
        <h3 class="text-3xl lg:text-6xl p-0 mb-3 underline text-white">Our Sponsors & Partners</h3> <!--- ampersand or the word "and?" -->
        <!-- left side -->
         <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 auto-rows-fr">
         {sponsors.map((s) => (
          <li class="grid">
          <SponsorBadge
            name={s.data.name}
            tier={s.data.tier}
            src={s.data.logo}
            website={s.data.website}
            color="bg-pgreen"
          />
          </li>
         ))}
         </ul>
      </div>
      <div class="flex flex-row w-1/3 md:w-1/6 h-full justify-end justify-self-stretch self-stretch items-center content-center object-contain group gap-0 p-0px">
        <!-- right side -->
        <div class="flex flex-row object-contain justify-center items-center justify-self-stretch self-stretch xl:p-5 h-full lg:ml-0px">
        <a class="flex flex-row justify-self-stretch min-w-full min-h-full" href="/sponsors">
            <div class="flex flex-row min-h-full justify-center items-center self-stretch group gap-0 bg-amber-300 shadow-card hover:shadow-hover transition rounded-xl border-1 border-black z-2 lg:px-5 xl:py-10">
                <p class="text-xl lg:text-2xl xl:text-3xl text-center md:px-2">Sponsor Us!</p>
            </div>
        </a>
      </div>  
    </div>
    </div>
</section>