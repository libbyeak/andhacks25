---
/* This will be the links for volunteers & mentors
*/
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif}"
);
---
<section class="bg-white border-2 border-black group rounded-xl sm:m-5 sm:p-5">
    <a name="sign-ups">
        <h1 style="padding-top: 60px; margin-top: -300px;">&nbsp</h1>
    </a>
    <div class="flex flex-col gap-6 justify-center md:w-1/2">
    <p class="text-6xl font-bold text-black">Interested in Volunteering?</p>
    <a 
        href="https://forms.gle/97bwLFs8i6Pi88z97"
        target="_self" 
        class="bg-yellow-400 text-black px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition">Volunteer Form</a> 
    <p class="text-6xl font-bold text-black">Interested in Mentoring or Juding?</p>
    <a
        href="https://forms.gle/s7d9CttG6njfxmWQ6"
        target="_self" 
        class="bg-yellow-400 text-black px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition">Mentor/Judge Form</a> 
    </div>
</section>