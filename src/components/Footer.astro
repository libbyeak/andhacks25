---
import { Image } from "astro:assets";
import instagram from "@/assets/instagramlogo.svg"
import discord from "@/assets/discordlogo.svg"
import devpost from "@/assets/devpostlogo.svg"

---

<footer
  class="flex flex-col items-center container mx-auto p-10 text-center gap-10 pb-40 bg-pdarkblue opacity-bg-30"
>

  <div class="flex items-center gap-6 text-5xl">
    <a
      href="https://www.instagram.com/andhackswm/#"
      target="_blank"
      class="border-1 p-1 border-black rounded-full bg-ppink shadow-card hover:shadow-hover transition"
    >
      <Image width="75" height="75" src={instagram} alt="" />
      
    </a>
    <a
      href="https://discord.gg/b32XKWe4N4" 
      target="_blank"
      class="border-1 p-3 border-black rounded-full bg-pblue shadow-card hover:shadow-hover transition"
    >
      <Image  width='60' height='60' src={discord} alt="" />
    </a>
    <a
      href="https://andhacks-x.devpost.com/project-gallery"
      target="_blank"
      class="border-1 p-3 border-black rounded-full bg-pgreen shadow-card hover:shadow-hover transition"
    >
    <Image class="p-10px m-10px" width="60" height="60" src={devpost} alt="" />
  </a>
  </div>
  <a
    href="/registration"
    target="_blank"
    rel="noopener noreferrer"
    class="bg-yellow-400 hover:bg-yellow-300 text-black font-bold py-2 px-6 rounded-xl shadow-md flex items-center gap-2 transition duration-200"
  >
    Register now!
  </a>
  <div class="flex items-center gap-6 text-5xl text-white">
    <p style="font-size:18px"> Made by W&M's &hacks team </p>
  </div>
</footer>
