---
const today = new Date();
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Instalogo from "src/assets/insta_logo.png"
---

<footer
  class="flex flex-col items-center container mx-auto p-10 text-center gap-10 pb-40"
>

  <div class="flex items-center gap-6 text-5xl">
    <a
      href="https://www.instagram.com/andhackswm/#"
      target="_blank"
      class="py-1 pl-3 rounded-md border-1 border-black bg-ppink shadow-card hover:shadow-hover transition"
    >
      <Icon name="web" />
      <Image src=Instalogo alt="logo" />
    </a>
    <a
      href="https://andhacks-x.devpost.com/project-gallery" 
      target="_blank"
      class="border-1 p-1 border-black rounded-full bg-pblue shadow-card hover:shadow-hover transition"
    >
      <Icon name="github" />
    </a>
    <a
      href="https://discord.gg/hCyxsqWePS"
      target="_blank"
      class="border-1 p-1 border-black rounded-full bg-pgreen shadow-card hover:shadow-hover transition"
    >
      <Icon name="linkedin" />
    </a>
  </div>
  <a
    href="/registration"
    target="_blank"
    rel="noopener noreferrer"
    class="bg-yellow-400 hover:bg-yellow-300 text-black font-bold py-2 px-6 rounded-xl shadow-md flex items-center gap-2 transition duration-200"
  >
    Register now!
  </a>
</footer>
