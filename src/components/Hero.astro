---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import AmpersandChallengeImage from "@/assets/andy_YOTE.png";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif}"
);

---

<section class="py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <p class="text-6xl font-bold">Thanks for</p>
    <p class="text-6xl font-bold"> a great event!</p>
    <p>
     Stay tuned for details of &hacks XII!
    </p>
    <a
      rel="noopener noreferrer"
      href="andhacks-xi.devpost.com"
      target="_self"
      class="bg-yellow-400 px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition"
    >
      View the Winners
    </a>
    <a
    rel="noopener noreferrer"
    href=""
    target="_self"
    class="bg-green-800 px-9 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition text-white text-center"
    >
    Read Our Recap (Coming Soon)
    </a>
  </div>
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <!-- <p class="text-6xl font-bold">HEADER AREA</p>-->
    <Image src={AmpersandChallengeImage} alt="Ampersand Challenge at &hacks" class="object-cover rounded-xl" width="500" height="500" />
  </div>
</section>
