---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif}"
);
---

<section class="py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <p class="text-6xl font-bold">Register for</p>
    <p class="text-6xl font-bold"> &hacks XI</p>
    <p>
      Join us September 26-28!
    </p>
    <a
      rel="noopener noreferrer"
      href="https://docs.google.com/forms/d/e/1FAIpQLSe1acd8N2XHjl3nKK3HLksLN5aKocuWEgU55ZXL2CvS5Uz-pg/viewform?usp=sharing&ouid=115916899614560916904"
      target="_blank"
      class="bg-pgreen px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition"
    >
      Register today!
    </a>
  </div>
  
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <p class="text-6xl font-bold">HEADER AREA</p>
  </div>
</section>
