---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import AmpersandChallengeImage from "@/assets/andy_YOTE.png";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif}"
);

---

<section class="py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <p class="text-6xl font-bold">Register for</p>
    <p class="text-6xl font-bold"> &hacks XI</p>
    <p>
      Join us September 27-28!
    </p>
    <a
      rel="noopener noreferrer"
      href="/registration"
      target="_self"
      class="bg-yellow-400 px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition"
    >
      Register today!
    </a>
    <a
    rel="noopener noreferrer"
    href="https://andhacks11.notion.site/hacks-XI-Day-of-Document-274ea5e3d4cb807f97f1d7513d138b8d?pvs=143"
    target="_self"
    class="bg-green-800 px-9 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition text-white"
    >
    Day-of Doc
    </a>
  </div>
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <!-- <p class="text-6xl font-bold">HEADER AREA</p>-->
    <Image src={AmpersandChallengeImage} alt="Ampersand Challenge at &hacks" class="object-cover rounded-xl" width="500" height="500" />
  </div>
</section>
