---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import AmpersandChallengeImage from "@/assets/andy_YOTE.png";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif}"
);

---

<section class="py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <p class="text-6xl font-bold">COMING SOON: &HACKS XII</p>
    <p class="text-6xl font-bold"> Sept. 25 - 27</p>
    <p>
      See &hacks XI's winners:
    </p>
    <a
    rel="noopener noreferrer"
    href="https://andhacks-xi.devpost.com/project-gallery"
    target="_self"
    class="bg-yellow-400 px-9 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition text-black"
    >
    Project Gallery
    </a>
  </div>
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <!-- <p class="text-6xl font-bold">HEADER AREA</p>-->
    <Image src={AmpersandChallengeImage} alt="Ampersand Challenge at &hacks" class="object-cover rounded-xl" width="500" height="500" />
  </div>
</section>
